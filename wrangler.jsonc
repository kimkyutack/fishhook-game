{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fishhook-game",
  "main": "src/server/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"],
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_WORLD", "class_name": "GameWorldDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameWorldDO"] }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "env": {
    "staging": {
      "name": "fishhook-game-staging",
      "durable_objects": {
        "bindings": [{ "name": "GAME_WORLD", "class_name": "GameWorldDO" }],
      },
    },
  },
}
