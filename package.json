{
  "name": "moyeo-fishing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev --port 8787",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "assets:check": "node --import tsx scripts/check-assets.ts",
    "simulate": "node --import tsx scripts/simulate.ts",
    "deploy": "npm run build && wrangler deploy --env=\"\"",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "types": "wrangler types",
    "assets:pack": "node --import tsx scripts/pack-assets.ts",
    "assets:pack:diagonal": "node --import tsx scripts/pack-diagonal-assets.ts",
    "assets:pack:costumes": "node --import tsx scripts/pack-costume-assets.ts",
    "assets:check:costumes": "node --import tsx scripts/check-costume-assets.ts",
    "test:load": "node --import tsx scripts/load-test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.ts\" \"tests/*.ts\" \"*.ts\" package.json tsconfig.json wrangler.jsonc"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.2",
    "@cloudflare/workers-types": "5.20261125.1",
    "@types/node": "26.6.9",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "^3.10.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.168.0",
    "ws": "8.23.0"
  }
}
